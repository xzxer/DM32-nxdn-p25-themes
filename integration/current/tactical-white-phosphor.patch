 }
+
+// --- Tactical boot screen: a reticle, the board name, the owner's lines, board and version. Drawn from lines in the
+// palette's colors (no bitmap)
+static void tac_circle(int cx, int cy, int r, color_t c)
+{
+	int x = r, y = 0, err = 1 - r;
+	while (x >= y) {
+		gfx_pixel(cx + x, cy + y, c); gfx_pixel(cx - x, cy + y, c);
+		gfx_pixel(cx + x, cy - y, c); gfx_pixel(cx - x, cy - y, c);
+		gfx_pixel(cx + y, cy + x, c); gfx_pixel(cx - y, cy + x, c);
+		gfx_pixel(cx + y, cy - x, c); gfx_pixel(cx - y, cy - x, c);
+		y++;
+		if (err < 0)
+			err += 2 * y + 1;
+		else {
+			x--;
+			err += 2 * (y - x) + 1;
+		}
+	}
+}
+
+static void tac_reticle(int cx, int cy, int r)
+{
+	int r2 = r * 2 / 3, r3 = r / 3, gap = r / 6;
+	tac_circle(cx, cy, r, NVG_LINE);
+	tac_circle(cx, cy, r2, NVG_FG);
+	tac_circle(cx, cy, r3, NVG_DIM);
+	// The cross, open in the middle
+	gfx_vline(cx, cy - r2, r2 - gap, NVG_FG);
+	gfx_vline(cx, cy + gap + 1, r2 - gap, NVG_FG);
+	gfx_hline(cx - r2, cy, r2 - gap, NVG_FG);
+	gfx_hline(cx + gap + 1, cy, r2 - gap, NVG_FG);
+	// Ticks on the outer ring: long at the four points, short between
+	for (int i = 1; i <= 3; i++) {
+		int d = r2 + i * (r - r2) / 4;
+		int t = i == 2 ? 3 : 2;
+		gfx_hline(cx - t, cy - d, 2 * t + 1, NVG_DIM);
+		gfx_hline(cx - t, cy + d, 2 * t + 1, NVG_DIM);
+		gfx_vline(cx - d, cy - t, 2 * t + 1, NVG_DIM);
+		gfx_vline(cx + d, cy - t, 2 * t + 1, NVG_DIM);
+	}
+	// The center: a small diamond
+	for (int k = 0; k < 3; k++)
+		gfx_hline(cx - k, cy - 2 + k, 2 * k + 1, NVG_FG), gfx_hline(cx - k, cy + 2 - k, 2 * k + 1, NVG_FG);
+	// Corner brackets of the frame
+	int b = r + 6, l = r / 4;
+	gfx_hline(cx - b, cy - b, l, NVG_FG); gfx_vline(cx - b, cy - b, l, NVG_FG);
+	gfx_hline(cx + b - l + 1, cy - b, l, NVG_FG); gfx_vline(cx + b, cy - b, l, NVG_FG);
+	gfx_hline(cx - b, cy + b, l, NVG_FG); gfx_vline(cx - b, cy + b - l + 1, l, NVG_FG);
+	gfx_hline(cx + b - l + 1, cy + b, l, NVG_FG); gfx_vline(cx + b, cy + b - l + 1, l, NVG_FG);
+}
+
+static void tactical_boot(const char *board_name, const char *version, const char *line1, const char *line2)
+{
+	int w = gfx_width(), h = gfx_height();
+	const ui_layout_t *L = &ui_layout;
+	gfx_clear(NVG_BG);
+	int r = h >= 300 ? 56 : 40, cy = (h >= 300 ? 36 : 20) + r + 6;
+	tac_reticle(w / 2, cy, r);
+	int y = cy + r + 20;
+	const font_t *nf = gfx_text_width(L->large, board_name) <= w - 8 ? L->large : L->medium;
+	kawaii_center(nf, y, board_name, NVG_FG);
+	y += nf->h + 4;
+	gfx_hline(w / 2 - w / 6, y, w / 3, NVG_DIM);
+	y += 8;
+	if (line1 != NULL && line1[0]) {
+		kawaii_center(L->small, y, line1, NVG_FG);
+		y += L->small->h;
+	}
+	if (line2 != NULL && line2[0])
+		kawaii_center(L->small, y, line2, NVG_FG);
+	char foot[48];
+	sbuf_t b;
+	sb_init(&b, foot, sizeof foot);
+	sb_str(&b, board_name);
+	sb_chr(&b, ' ');
+	sb_str(&b, version);
+	kawaii_center(L->tiny, h - L->tiny->h - 2, foot, NVG_DIM);
+}
 #else
 #define kawaii() false
