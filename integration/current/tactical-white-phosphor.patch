+#define NVG_BG RGB565(8, 16, 16)
+#define NVG_FG RGB565(216, 248, 240)
+#define NVG_DIM RGB565(136, 176, 176)
+#define NVG_LINE RGB565(40, 64, 64)
+#define NVG_RX RGB565(160, 240, 248)
