+// The visual styles' own large fonts (the channel, the talk target, headings), ASCII only, all OFL-1.1: Kode Mono,
+// Chivo Mono, VT323, Azeret Mono, Courier Prime, Sixtyfour and Doto (core/ui/fonts/<face>_*.inc carry each one's
+// copyright and license), converted by tools/fontconv.py at the JetBrains Mono cells so every layout stays the same.
+// Accented letters fall back to plain ASCII; the four extra glyphs are JetBrains Mono's
+#if CONFIG_UI_KAWAII && CONFIG_FONT_AA && CONFIG_FONT_XL
+#include "fonts/kode_12x24.inc"
+#include "fonts/kode_16x32.inc"
+#include "fonts/chivo_12x24.inc"
+#include "fonts/chivo_16x32.inc"
+#include "fonts/vt323_12x24.inc"
+#include "fonts/vt323_16x32.inc"
+#include "fonts/azeret_12x24.inc"
+#include "fonts/azeret_16x32.inc"
+#include "fonts/courier_12x24.inc"
+#include "fonts/courier_16x32.inc"
+#include "fonts/sixtyfour_12x24.inc"
+#include "fonts/sixtyfour_16x32.inc"
+#include "fonts/doto_12x24.inc"
+#include "fonts/doto_16x32.inc"
+FONT(font_kode_12x24, kode_12x24, KODE_12X24, KODE_12X24_BPP);
+FONT(font_kode_16x32, kode_16x32, KODE_16X32, KODE_16X32_BPP);
+FONT(font_chivo_12x24, chivo_12x24, CHIVO_12X24, CHIVO_12X24_BPP);
+FONT(font_chivo_16x32, chivo_16x32, CHIVO_16X32, CHIVO_16X32_BPP);
+FONT(font_vt323_12x24, vt323_12x24, VT323_12X24, VT323_12X24_BPP);
+FONT(font_vt323_16x32, vt323_16x32, VT323_16X32, VT323_16X32_BPP);
+FONT(font_azeret_12x24, azeret_12x24, AZERET_12X24, AZERET_12X24_BPP);
+FONT(font_azeret_16x32, azeret_16x32, AZERET_16X32, AZERET_16X32_BPP);
+FONT(font_courier_12x24, courier_12x24, COURIER_12X24, COURIER_12X24_BPP);
+FONT(font_courier_16x32, courier_16x32, COURIER_16X32, COURIER_16X32_BPP);
+FONT(font_sixtyfour_12x24, sixtyfour_12x24, SIXTYFOUR_12X24, SIXTYFOUR_12X24_BPP);
+FONT(font_sixtyfour_16x32, sixtyfour_16x32, SIXTYFOUR_16X32, SIXTYFOUR_16X32_BPP);
+FONT(font_doto_12x24, doto_12x24, DOTO_12X24, DOTO_12X24_BPP);
