+	for (uint16_t i = top; i < l->count && i < top + capacity; i++) {
+		ui_item_t it = {0};
+		l->item(i, &it);
+		int col = (i - top) % 2, row = (i - top) / 2;
+		int x = col * (w / 2) + 3, ty = y + row * pitch + 4, cw = w / 2 - 6, ch = pitch - 8;
+		bool focus = i == l->focus;
