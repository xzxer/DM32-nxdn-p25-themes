+// --- Tactical boot screen: a reticle, the board name, the owner's lines, board and version. Drawn from lines in the
+// palette's colors (no bitmap)
+static void tac_circle(int cx, int cy, int r, color_t c)
+{
+	int x = r, y = 0, err = 1 - r;
+	while (x >= y) {
+		gfx_pixel(cx + x, cy + y, c); gfx_pixel(cx - x, cy + y, c);
+		gfx_pixel(cx + x, cy - y, c); gfx_pixel(cx - x, cy - y, c);
+		gfx_pixel(cx + y, cy + x, c); gfx_pixel(cx - y, cy + x, c);
+		gfx_pixel(cx + y, cy - x, c); gfx_pixel(cx - y, cy - x, c);
+		y++;
+		if (err < 0)
+			err += 2 * y + 1;
+		else {
+			x--;
+			err += 2 * (y - x) + 1;
+		}
+	}
+}
+
+static void tac_brackets(int cx, int cy, int b, int l, color_t c)
+{
+	gfx_hline(cx - b, cy - b, l, c); gfx_vline(cx - b, cy - b, l, c);
+	gfx_hline(cx + b - l + 1, cy - b, l, c); gfx_vline(cx + b, cy - b, l, c);
+	gfx_hline(cx - b, cy + b, l, c); gfx_vline(cx - b, cy + b - l + 1, l, c);
+	gfx_hline(cx + b - l + 1, cy + b, l, c); gfx_vline(cx + b, cy + b - l + 1, l, c);
+}
+
+static void tac_reticle(const tac_pal_t *p, int cx, int cy, int r)
+{
+	int r2 = r * 2 / 3, r3 = r / 3, gap = r / 6;
+	tac_circle(cx, cy, r, p->line);
+	tac_circle(cx, cy, r2, p->fg);
+	tac_circle(cx, cy, r3, p->dim);
+	// The cross, open in the middle
+	gfx_vline(cx, cy - r2, r2 - gap, p->fg);
+	gfx_vline(cx, cy + gap + 1, r2 - gap, p->fg);
+	gfx_hline(cx - r2, cy, r2 - gap, p->fg);
+	gfx_hline(cx + gap + 1, cy, r2 - gap, p->fg);
+	// Ticks on the outer ring: long at the four points, short between
+	for (int i = 1; i <= 3; i++) {
+		int d = r2 + i * (r - r2) / 4;
+		int t = i == 2 ? 3 : 2;
+		gfx_hline(cx - t, cy - d, 2 * t + 1, p->dim);
+		gfx_hline(cx - t, cy + d, 2 * t + 1, p->dim);
+		gfx_vline(cx - d, cy - t, 2 * t + 1, p->dim);
+		gfx_vline(cx + d, cy - t, 2 * t + 1, p->dim);
+	}
+	// The center: a small diamond
+	for (int k = 0; k < 3; k++) {
+		gfx_hline(cx - k, cy - 2 + k, 2 * k + 1, p->fg);
+		gfx_hline(cx - k, cy + 2 - k, 2 * k + 1, p->fg);
+	}
+	tac_brackets(cx, cy, r + 6, r / 4, p->fg);
+}
+
+// A unit badge: a shield (square shoulders, a pointed foot) with a mast and two chevrons, in a 2 r square
+static void tac_badge(const tac_pal_t *p, int cx, int cy, int r)
+{
+	int top = cy - r, side = r - 4, body = r * 6 / 5;	// straight sides, then the point
+	for (int t = 0; t < 3; t++) {			// a 3 px coyote border
+		int x0 = cx - side + t, x1 = cx + side - t, y0 = top + t, yb = top + body;
+		gfx_hline(x0, y0, x1 - x0 + 1, p->focus);
+		gfx_vline(x0, y0, yb - y0, p->focus);
+		gfx_vline(x1, y0, yb - y0, p->focus);
+		int len = 2 * r - body - t;		// the two edges down to the point, one pixel in a row
+		for (int k = 0; k < len; k++) {
+			int dx = (side - t) * k / len;
+			gfx_pixel(x0 + dx, yb + k, p->focus);
+			gfx_pixel(x1 - dx, yb + k, p->focus);
+		}
+	}
+	// Inside: a hint-colored field with a dashed inner rule
+	for (int y = top + 5; y < top + body; y++)
+		gfx_hline(cx - side + 5, y, 2 * side - 9, p->hint_bg);
+	for (int x = cx - side + 7; x < cx + side - 6; x += 6)
+		gfx_hline(x, top + 7, 3, p->line);
+	// The mast: a vertical with a crossbar foot and two arcs either side, as an antenna on the air
+	int my = top + r / 3, mh = r * 2 / 3;
+	for (int d = -1; d <= 1; d++)
+		gfx_vline(cx + d, my, mh, p->fg);
+	gfx_hline(cx - r / 4, my + mh, r / 2 + 1, p->fg);
+	for (int a = 0; a < 2; a++) {
+		int ar = r / 5 + a * r / 6;
+		for (int y = -ar * 3 / 4; y <= ar * 3 / 4; y++) {
+			int x = 0;
+			while ((x + 1) * (x + 1) + y * y <= ar * ar)
+				x++;
+			gfx_pixel(cx - x - 1, my + mh / 3 + y, p->focus);
+			gfx_pixel(cx + x + 1, my + mh / 3 + y, p->focus);
+		}
+	}
+	// Two chevrons under it, pointing down
+	for (int c = 0; c < 2; c++) {
+		int y0 = my + mh + 6 + c * 7, half = r / 2;
+		for (int k = 0; k <= half; k++)
+			for (int t = 0; t < 3; t++) {
+				gfx_pixel(cx - half + k, y0 + k * 2 / 5 + t, p->focus);
+				gfx_pixel(cx + half - k, y0 + k * 2 / 5 + t, p->focus);
+			}
+	}
+}
+
+static void tac_disc(int cx, int cy, int r, color_t c)
+{
+	for (int y = -r; y <= r; y++) {
+		int x = 0;
+		while ((x + 1) * (x + 1) + y * y <= r * r)
+			x++;
+		gfx_hline(cx - x, cy + y, 2 * x + 1, c);
+	}
+}
+
+// Twelve points round a circle, sin and cos in 1/64ths, from 12 o'clock clockwise
+static const int8_t tac_sin12[12] = { 0, 32, 55, 64, 55, 32, 0, -32, -55, -64, -55, -32 };
+#define TAC_COS12(i) (tac_sin12[((i) + 3) % 12])
+
+// An attitude indicator: ground below the horizon, a pitch ladder, the bank scale on top and the aircraft symbol
+static void tac_horizon(const tac_pal_t *p, int cx, int cy, int r)
+{
+	for (int y = 1; y <= r; y++) {
+		int x = 0;
+		while ((x + 1) * (x + 1) + y * y <= r * r)
+			x++;
+		gfx_hline(cx - x, cy + y, 2 * x + 1, p->hint_bg);
+	}
+	tac_circle(cx, cy, r, p->dim);
+	tac_circle(cx, cy, r + 1, p->dim);
+	gfx_hline(cx - r + 1, cy, 2 * r - 1, p->fg);
+	for (int k = 1; k <= 2; k++) {
+		int d = k * r / 3, l = k == 1 ? r / 3 : r / 2;
+		gfx_hline(cx - l / 2, cy - d, l, p->dim);
+		gfx_hline(cx - l / 2, cy + d, l, p->dim);
+	}
+	for (int i = -2; i <= 2; i++) {	// the bank scale: 12 o'clock and two marks either side
+		int a = (12 + i) % 12, t = i == 0 ? 8 : 5;
+		for (int k = 0; k < t; k++)
+			gfx_pixel(cx + tac_sin12[a] * (r + 4 + k) / 64, cy - TAC_COS12(a) * (r + 4 + k) / 64, p->fg);
+	}
+	for (int t = 0; t < 3; t++) {	// the aircraft: two wings and a center dot
+		gfx_hline(cx - r * 2 / 3, cy + t - 1, r / 3, p->focus);
+		gfx_hline(cx + r / 3 + 1, cy + t - 1, r / 3, p->focus);
+		gfx_vline(cx - r / 3 + t - 2, cy, 6, p->focus);
+		gfx_vline(cx + r / 3 + t, cy, 6, p->focus);
+	}
+	tac_disc(cx, cy, 3, p->focus);
+}
+
+// A thermal sight: a hot spot in the sensor's colors, a broken crosshair and corner brackets
+static void tac_sight(const tac_pal_t *p, int cx, int cy, int r)
+{
+	int hx = cx + r / 5, hy = cy + r / 6;
+	tac_disc(hx, hy, r / 2, p->line);
+	tac_disc(hx, hy, r / 3, p->dim);
+	tac_disc(hx, hy, r / 5, p->rx);
+	tac_disc(hx, hy, r / 10, p->fg);
+	int gap = r / 5;
+	for (int t = -1; t <= 1; t++) {
+		gfx_vline(cx + t, cy - r, r - gap, p->focus);
+		gfx_vline(cx + t, cy + gap + 1, r - gap, p->focus);
+		gfx_hline(cx - r, cy + t, r - gap, p->focus);
+		gfx_hline(cx + gap + 1, cy + t, r - gap, p->focus);
+	}
+	for (int k = 1; k <= 3; k++) {	// stadia marks
+		gfx_hline(cx - 3, cy + gap + k * (r - gap) / 4, 7, p->fg);
+		gfx_vline(cx - gap - k * (r - gap) / 4, cy - 3, 7, p->fg);
+		gfx_vline(cx + gap + k * (r - gap) / 4, cy - 3, 7, p->fg);
+	}
+	tac_brackets(cx, cy, r + 4, r / 3, p->fg);
+	tac_brackets(cx, cy, r + 5, r / 3, p->fg);
+}
+
+// A faceplate dial: a knob with a pointer, twelve detents and four panel screws
+static void tac_dial(const tac_pal_t *p, int cx, int cy, int r)
+{
+	for (int i = 0; i < 12; i++) {
+		int t = i % 3 == 0 ? 7 : 4;
+		for (int k = 0; k < t; k++)
+			for (int w = 0; w < 2; w++)
+				gfx_pixel(cx + tac_sin12[i] * (r - k) / 64 + w, cy - TAC_COS12(i) * (r - k) / 64, i % 3 == 0 ? p->fg : p->dim);
+	}
+	int kr = r * 2 / 3;
+	tac_disc(cx, cy, kr, p->hint_bg);
+	tac_circle(cx, cy, kr, p->fg);
+	tac_circle(cx, cy, kr - 4, p->line);
+	for (int k = 6; k < kr - 2; k++)	// the pointer at ten o'clock
+		for (int w = -1; w <= 1; w++)
+			gfx_pixel(cx + tac_sin12[10] * k / 64 + w, cy - TAC_COS12(10) * k / 64 + w, p->focus);
+	tac_disc(cx, cy, 4, p->focus);
+	int s = r + 6;
+	for (int i = 0; i < 4; i++) {
+		int sx = cx + (i & 1 ? s : -s), sy = cy + (i & 2 ? s : -s);
+		tac_circle(sx, sy, 4, p->dim);
+		gfx_hline(sx - 2, sy, 5, p->dim);
+	}
+}
+
+#define TAC_ABS(v) ((v) < 0 ? -(v) : (v))
+
+static int tac_isqrt(int v)
+{
+	int r = 0;
+	while (v > 0 && (r + 1) * (r + 1) <= v)
+		r++;
+	return r;
+}
+
+// Twenty-four points round a circle (15 degrees apart), sin in 1/64ths, from 12 o'clock clockwise
+static const int8_t tac_sin24[24] = { 0, 17, 32, 45, 55, 62, 64, 62, 55, 45, 32, 17, 0, -17, -32, -45, -55, -62, -64, -62, -55, -45,
+				      -32, -17 };
+#define TAC_X24(i, r) (tac_sin24[(i) % 24] * (r) / 64)
+#define TAC_Y24(i, r) (-tac_sin24[((i) + 6) % 24] * (r) / 64)
+
+static void tac_ray(int cx, int cy, int i, int r0, int r1, int w, color_t c)
+{
+	for (int k = r0; k <= r1; k++)
+		for (int d = 0; d < w; d++)
+			gfx_pixel(cx + TAC_X24(i, k) + d, cy + TAC_Y24(i, k), c);
+}
+
+// A thin line from (x0, y0) to (x1, y1), w pixels wide
+static void tac_line(int x0, int y0, int x1, int y1, int w, color_t c)
+{
+	int dx = x1 - x0, dy = y1 - y0, n = TAC_ABS(dx) > TAC_ABS(dy) ? TAC_ABS(dx) : TAC_ABS(dy);
+	for (int k = 0; k <= n; k++)
+		for (int d = 0; d < w; d++) {
+			int x = x0 + (n ? dx * k / n : 0), y = y0 + (n ? dy * k / n : 0);
+			if (TAC_ABS(dx) > TAC_ABS(dy))
+				gfx_pixel(x, y + d, c);
+			else
+				gfx_pixel(x + d, y, c);
+		}
+}
+
+// The part of a circle a gauge sweeps: all but the 120 degree wedge at the bottom
+static void tac_gauge_arc(int cx, int cy, int r, color_t c, color_t red)
+{
+	for (int y = -r; y <= r; y++)
+		for (int x = -r; x <= r; x++) {
+			int d = x * x + y * y;
+			if (d > r * r || d < (r - 2) * (r - 2))
+				continue;
+			if (y > 0 && TAC_ABS(x) * 1000 < 1732 * y)
+				continue;
+			gfx_pixel(cx + x, cy + y, x > 0 && y > -r / 2 ? red : c);	// the last stretch in red
+		}
+}
+
+// A VU meter: a cream face, a flat scale with its red end, the needle off its pivot below
+static void tac_vu(const tac_pal_t *p, int cx, int cy, int r)
+{
+	int x0 = cx - r, y0 = cy - r * 3 / 4, w = 2 * r, h = r * 3 / 2;
+	for (int y = y0; y < y0 + h; y++)
+		gfx_hline(x0, y, w, p->hint_bg);
+	for (int t = 0; t < 2; t++) {
+		gfx_hline(x0 - t, y0 - t, w + 2 * t, p->fg);
+		gfx_hline(x0 - t, y0 + h - 1 + t, w + 2 * t, p->fg);
+		gfx_vline(x0 - t, y0 - t, h + 2 * t, p->fg);
+		gfx_vline(x0 + w - 1 + t, y0 - t, h + 2 * t, p->fg);
+	}
+	int px = cx, py = y0 + h + r / 3, ar = h;		// the pivot below the face
+	for (int y = -ar; y <= 0; y++)
+		for (int x = -ar; x <= ar; x++) {
+			int d = x * x + y * y;
+			if (d > ar * ar || d < (ar - 2) * (ar - 2) || TAC_ABS(x) * 10 > -y * 9 || py + y < y0 + 4)
+				continue;
+			gfx_pixel(px + x, py + y, x * 10 > -y * 4 ? p->tx : p->fg);
+		}
+	for (int i = -3; i <= 3; i++) {			// ticks on the scale
+		int tx = px + i * ar * 2 / 19, ty = py - ar;
+		gfx_vline(tx, ty + (ar - tac_isqrt((ar * ar - (i * ar * 2 / 19) * (i * ar * 2 / 19)))), i % 3 ? 4 : 7,
+			  i > 1 ? p->tx : p->fg);
+	}
+	tac_line(px, py, px - ar / 3, py - ar + 6, 2, p->focus);	// the needle, left of center
+	tac_disc(px, y0 + h - 1, 4, p->focus);
+}
+
+// A tachometer: a gauge face, ticks round the sweep with the redline in red, the needle and its hub
+static void tac_tach(const tac_pal_t *p, int cx, int cy, int r)
+{
+	tac_disc(cx, cy, r, p->hint_bg);
+	tac_gauge_arc(cx, cy, r, p->fg, p->tx);
+	for (int k = 0; k <= 16; k++) {		// from 8 o'clock round to 4 o'clock
+		int i = (16 + k) % 24;
+		tac_ray(cx, cy, i, r - (k % 2 ? 6 : 10), r - 3, 2, k >= 13 ? p->tx : k % 2 ? p->dim : p->fg);
+	}
+	tac_line(cx, cy, cx + TAC_X24(22, r - 12), cy + TAC_Y24(22, r - 12), 3, p->focus);
+	tac_disc(cx, cy, 6, p->focus);
+	tac_disc(cx, cy, 2, p->bg);
+}
+
+// A gear: twelve teeth round a disc, a bore in the middle
+static void tac_gear(const tac_pal_t *p, int cx, int cy, int r)
+{
+	int t = r / 5;
+	for (int i = 0; i < 24; i += 2) {
+		for (int k = r * 3 / 4 - 2; k <= r; k++)	// a square-cut tooth: a short thick ray
+			for (int d = -t / 2 - 1; d <= t / 2 + 1; d++)
+				gfx_fill(cx + TAC_X24(i, k) + TAC_X24(i + 6, d), cy + TAC_Y24(i, k) + TAC_Y24(i + 6, d), 2, 2, p->focus);	// 2 px: no gaps on the diagonals
+	}
+	tac_disc(cx, cy, r * 3 / 4, p->focus);
+	tac_circle(cx, cy, r * 3 / 4 - 5, p->bg);
+	tac_disc(cx, cy, r / 3, p->bg);
+	tac_circle(cx, cy, r / 3, p->fg);
+	for (int k = 0; k < 4; k++)	// a keyway
+		gfx_hline(cx - 3, cy - r / 3 - 4 + k, 7, p->bg);
+}
+
+// An orbit: a planet, an elliptical track round it with a satellite on it, and a few stars
+static void tac_orbit(const tac_pal_t *p, int cx, int cy, int r)
+{
+	tac_disc(cx, cy, r / 3, p->hint_bg);
+	tac_circle(cx, cy, r / 3, p->dim);
+	int a = r, b = r * 2 / 5;
+	for (int x = -a; x <= a; x++) {		// the ellipse, by columns and rows so it has no gaps
+		int y = tac_isqrt((b * b - b * b * x * x / (a * a)));
+		gfx_pixel(cx + x, cy + y, p->fg);
+		if (y > r / 3 || TAC_ABS(x) > r / 3)
+			gfx_pixel(cx + x, cy - y, p->fg);	// behind the planet: hidden
+	}
+	for (int y = -b; y <= b; y++) {
+		int x = tac_isqrt((a * a - a * a * y * y / (b * b)));
+		gfx_pixel(cx + x, cy + y, p->fg);
+		gfx_pixel(cx - x, cy + y, p->fg);
+	}
+	int sx = cx + a * 3 / 5, sy = cy + b * 4 / 5;	// the satellite: a body and two panels
+	for (int k = -2; k <= 2; k++)
+		gfx_hline(sx - 2, sy + k, 5, p->focus);
+	for (int k = -1; k <= 1; k++) {
+		gfx_hline(sx - 12, sy + k, 8, p->chnum);
+		gfx_hline(sx + 5, sy + k, 8, p->chnum);
+	}
+	static const int8_t star[6][2] = { { -40, -46 }, { 44, -40 }, { -52, 20 }, { 30, -56 }, { 54, 30 }, { -20, 50 } };
+	for (int k = 0; k < 6; k++) {
+		int x = cx + star[k][0] * r / 56, y = cy + star[k][1] * r / 56;
+		gfx_pixel(x, y, p->fg); gfx_pixel(x - 1, y, p->dim); gfx_pixel(x + 1, y, p->dim);
+		gfx_pixel(x, y - 1, p->dim); gfx_pixel(x, y + 1, p->dim);
+	}
+}
+
+// One point of a compass rose: a narrow diamond from the center out to radius l
+static void tac_point(int cx, int cy, int i, int l, int w, color_t c)
+{
+	for (int k = 0; k <= l; k++) {
+		int half = k < l / 4 ? k * w / (l / 4 + 1) : (l - k) * w / (l - l / 4 + 1);
+		int x = cx + TAC_X24(i, k), y = cy + TAC_Y24(i, k);
+		for (int d = -half; d <= half; d++)
+			gfx_pixel(x + (i % 12 ? 0 : d), y + (i % 12 ? d : 0), c);
+	}
+}
+
+// A compass rose: a bezel with ticks, eight points, north in red, and the N
+static void tac_compass(const tac_pal_t *p, int cx, int cy, int r)
+{
+	tac_circle(cx, cy, r, p->fg);
+	tac_circle(cx, cy, r - 1, p->fg);
+	for (int i = 0; i < 24; i++)
+		tac_ray(cx, cy, i, r - (i % 6 ? 4 : 8), r - 2, 1, i % 6 ? p->dim : p->fg);
+	for (int i = 3; i < 24; i += 6)
+		tac_ray(cx, cy, i, 4, r * 3 / 5, 1, p->dim);	// the half points as rays
+	tac_point(cx, cy, 6, r * 3 / 4, 4, p->fg);
+	tac_point(cx, cy, 12, r * 3 / 4, 4, p->fg);
+	tac_point(cx, cy, 18, r * 3 / 4, 4, p->fg);
+	tac_point(cx, cy, 0, r * 3 / 4, 4, p->tx);
+	tac_disc(cx, cy, 3, p->focus);
+	kawaii_center(ui_layout.small, cy - r - ui_layout.small->h - 2, "N", p->tx);
+}
+
+// A brass ring: a double band with rivets and a diamond at the center, as a bottle seal or a saddle concho
+static void tac_ring(const tac_pal_t *p, int cx, int cy, int r)
+{
+	tac_disc(cx, cy, r, p->focus);
+	tac_disc(cx, cy, r - 3, p->bg);
+	tac_disc(cx, cy, r - 12, p->focus);
+	tac_disc(cx, cy, r - 15, p->hint_bg);
+	for (int i = 0; i < 24; i += 2)
+		tac_disc(cx + TAC_X24(i, r - 7), cy + TAC_Y24(i, r - 7), 1, p->dim);
+	int d = r / 3;
+	for (int k = 0; k <= d; k++) {
+		gfx_hline(cx - (d - k), cy - k, 2 * (d - k) + 1, p->focus);
+		gfx_hline(cx - (d - k), cy + k, 2 * (d - k) + 1, p->focus);
+	}
+	gfx_hline(cx - r + 18, cy, r / 2 - 8, p->dim);
+	gfx_hline(cx + d + 6, cy, r / 2 - 8, p->dim);
+}
+
+// A radar sweep: range rings, a cross, storm cells in the echo colors and the sweep line
+static void tac_sweep(const tac_pal_t *p, int cx, int cy, int r)
+{
+	int hx = cx + r / 3, hy = cy - r / 4;
+	tac_disc(hx, hy, r / 3, p->rx);
+	tac_disc(hx + 3, hy - 2, r / 5, p->warn);
+	tac_disc(hx + 5, hy - 3, r / 10, p->tx);
+	tac_disc(cx - r / 2, cy + r / 3, r / 6, p->rx);
+	tac_disc(cx - r / 2 + 2, cy + r / 3, r / 12, p->warn);
+	for (int k = 1; k <= 3; k++)
+		tac_circle(cx, cy, r * k / 3, p->line);
+	gfx_hline(cx - r, cy, 2 * r + 1, p->line);
+	gfx_vline(cx, cy - r, 2 * r + 1, p->line);
+	tac_circle(cx, cy, r, p->dim);
+	tac_line(cx, cy, cx + TAC_X24(2, r), cy + TAC_Y24(2, r), 2, p->fg);
+	tac_disc(cx, cy, 2, p->fg);
+}
+
+// A terminal: a window with a title bar, READY. and a block cursor
+static void tac_prompt(const tac_pal_t *p, int cx, int cy, int r)
+{
+	int x0 = cx - r - 8, y0 = cy - r * 3 / 4, w = 2 * r + 17, h = r * 3 / 2;
+	for (int y = y0; y < y0 + 10; y++)
+		gfx_hline(x0, y, w, p->strip_bg);
+	for (int t = 0; t < 2; t++) {
+		gfx_hline(x0, y0 + h - 1 - t, w, p->fg);
+		gfx_vline(x0 + t, y0, h, p->fg);
+		gfx_vline(x0 + w - 1 - t, y0, h, p->fg);
+	}
+	const font_t *f = ui_layout.medium;
+	gfx_text(f, x0 + 8, y0 + 18, "READY.", p->fg);
+	int cyy = y0 + 18 + f->h + 6;
+	for (int y = cyy; y < cyy + f->h; y++)
+		gfx_hline(x0 + 8, y, f->h * 2 / 3, p->focus);
+}
+
+static void tactical_boot(const char *board_name, const char *version, const char *line1, const char *line2)
+{
+	const tac_pal_t *p = tac_pal();
+	int w = gfx_width(), h = gfx_height();
+	const ui_layout_t *L = &ui_layout;
+	gfx_clear(p->bg);
+	int r = h >= 300 ? 56 : 40, cy = (h >= 300 ? 36 : 20) + r + 6;
+	switch (p->emblem) {
+	case TAC_EM_BADGE: tac_badge(p, w / 2, cy, r); break;
+	case TAC_EM_HORIZON: tac_horizon(p, w / 2, cy, r); break;
+	case TAC_EM_SIGHT: tac_sight(p, w / 2, cy, r); break;
+	case TAC_EM_DIAL: tac_dial(p, w / 2, cy, r); break;
+	case TAC_EM_VU: tac_vu(p, w / 2, cy, r); break;
+	case TAC_EM_TACH: tac_tach(p, w / 2, cy, r); break;
+	case TAC_EM_GEAR: tac_gear(p, w / 2, cy, r); break;
+	case TAC_EM_ORBIT: tac_orbit(p, w / 2, cy, r); break;
+	case TAC_EM_COMPASS: tac_compass(p, w / 2, cy, r); break;
+	case TAC_EM_RING: tac_ring(p, w / 2, cy, r); break;
+	case TAC_EM_SWEEP: tac_sweep(p, w / 2, cy, r); break;
+	case TAC_EM_PROMPT: tac_prompt(p, w / 2, cy, r); break;
+	default: tac_reticle(p, w / 2, cy, r); break;
+	}
+	int y = cy + r + 20;
+	const font_t *nf = gfx_text_width(L->large, board_name) <= w - 8 ? L->large : L->medium;
+	kawaii_center(nf, y, board_name, p->fg);
+	y += nf->h + 4;
+	gfx_hline(w / 2 - w / 6, y, w / 3, p->emblem != TAC_EM_RETICLE ? p->focus : p->dim);
+	y += 8;
+	if (line1 != NULL && line1[0]) {
+		kawaii_center(L->small, y, line1, p->fg);
+		y += L->small->h;
+	}
+	if (line2 != NULL && line2[0])
+		kawaii_center(L->small, y, line2, p->fg);
+	char foot[48];
+	sbuf_t b;
+	sb_init(&b, foot, sizeof foot);
+	sb_str(&b, board_name);
+	sb_chr(&b, ' ');
+	sb_str(&b, version);
+	kawaii_center(L->tiny, h - L->tiny->h - 2, foot, p->dim);
+}
 #else
 #define kawaii() false
 #define centered_home() false
+#define tactical() false
