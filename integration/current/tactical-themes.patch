+static const tac_pal_t *tac_pal(void)
+{
+	if (!ui_style_available())
+		return NULL;
+	uint8_t v = ui_accent < TAC_VARIANTS ? ui_accent : 0;
+	return ui_style == UI_STYLE_TACTICAL ? &tac_nvg[v] : ui_style == UI_STYLE_FIELD ? &tac_field[v] : NULL;
+}
+
+static bool tactical(void)
+{
+	return tac_pal() != NULL;
+}
+
+bool ui_style_tactical(void)
+{
+	return tactical();
+}
