+static const tac_pal_t *tac_pal(void)
+{
+	if (!ui_style_available())
+		return NULL;
+	for (unsigned i = 0; i < sizeof tac_styles / sizeof tac_styles[0]; i++)
+		if (tac_styles[i].style == ui_style)
+			return &tac_styles[i].v[ui_accent < tac_styles[i].n ? ui_accent : 0];	// a variant the style lacks: its first
+	return NULL;
+}
+
+// The large fonts of the style in use, TAC_FONT_*
+static uint8_t tac_font(void)
+{
+	if (!ui_style_available())
+		return TAC_FONT_STOCK;
+	for (unsigned i = 0; i < sizeof tac_styles / sizeof tac_styles[0]; i++)
+		if (tac_styles[i].style == ui_style)
+			return tac_styles[i].font;
+	return TAC_FONT_STOCK;
+}
+
+static bool tactical(void)
+{
+	return tac_pal() != NULL;
+}
