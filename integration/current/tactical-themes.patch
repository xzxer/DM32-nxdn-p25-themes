+// The visual styles' own large fonts (channel names, headings), ASCII only: Share Tech Mono by Carrois Type Design for
+// the military styles and B612 Mono Bold by the B612 Project for the others (both OFL-1.1, core/ui/fonts/stmono_*.inc,
+// b612_*.inc), converted by tools/fontconv.py at the JetBrains Mono cells so every layout stays the same
+#if CONFIG_UI_KAWAII && CONFIG_FONT_AA && CONFIG_FONT_XL
+#include "fonts/stmono_12x24.inc"
+#include "fonts/stmono_16x32.inc"
+#include "fonts/b612_12x24.inc"
+#include "fonts/b612_16x32.inc"
+FONT(font_mil_12x24, stmono_12x24, STMONO_12X24, STMONO_12X24_BPP);
+FONT(font_mil_16x32, stmono_16x32, STMONO_16X32, STMONO_16X32_BPP);
+FONT(font_tech_12x24, b612_12x24, B612_12X24, B612_12X24_BPP);
+FONT(font_tech_16x32, b612_16x32, B612_16X32, B612_16X32_BPP);
+#endif
