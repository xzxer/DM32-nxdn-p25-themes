+// The tactical styles: RadioFoundry's layout in a palette of their own, with no ornaments. Each palette has few hues,
+// so it costs few of the 16 palette slots; every color is exact in RGB565
+typedef struct {
+	color_t bg, fg, dim, line, tx, rx, warn, idle, hint_bg, priv;
+	color_t strip_bg, strip_warn;	// the filled status strip (its text is bg)
+	color_t focus, chnum;		// the focus row (its text is bg), Home's channel number
+	bool badge;			// boot emblem: a unit badge, else a reticle
+} tac_pal_t;
+
+// White phosphor: blue-green white on near-black, as a white phosphor night vision tube. Text on the background at
+// least 7:1 (fg 17:1, dim 8:1); TX stays red-orange, the one warm color, so it can't be missed
+static const tac_pal_t tac_nvg = {
+	.bg = RGB565(8, 16, 16), .fg = RGB565(216, 248, 240), .dim = RGB565(136, 176, 176), .line = RGB565(40, 64, 64),
+	.tx = RGB565(200, 48, 24), .rx = RGB565(160, 240, 248), .warn = RGB565(248, 216, 112), .idle = RGB565(88, 120, 120),
+	.hint_bg = RGB565(20, 36, 36), .priv = RGB565(120, 200, 248),
+	.strip_bg = RGB565(136, 176, 176), .strip_warn = RGB565(96, 40, 0),	// muted, so the RX pill stands out on it
+	.focus = RGB565(216, 248, 240), .chnum = RGB565(160, 240, 248), .badge = false,
+};
+
+// Field Drab: tan text on olive drab, coyote highlights, as gear stencils and unit patches. Text on the background
+// at least 6:1 (fg 13:1, dim 6:1)
+static const tac_pal_t tac_field = {
+	.bg = RGB565(24, 28, 16), .fg = RGB565(224, 216, 184), .dim = RGB565(160, 148, 112), .line = RGB565(76, 80, 52),
+	.tx = RGB565(200, 56, 32), .rx = RGB565(168, 192, 80), .warn = RGB565(232, 160, 48), .idle = RGB565(120, 112, 80),
+	.hint_bg = RGB565(44, 48, 32), .priv = RGB565(144, 176, 208),
+	.strip_bg = RGB565(224, 216, 184), .strip_warn = RGB565(120, 48, 0),	// tan, so the olive RX pill stands out on it
+	.focus = RGB565(200, 168, 104), .chnum = RGB565(200, 168, 104), .badge = true,
+};
+
+static const tac_pal_t *tac_pal(void)
+{
+	if (!ui_style_available())
+		return NULL;
+	return ui_style == UI_STYLE_TACTICAL ? &tac_nvg : ui_style == UI_STYLE_FIELD ? &tac_field : NULL;
+}
+
+static bool tactical(void)
+{
+	return tac_pal() != NULL;
+}
+
 bool ui_home_name_first_available(void)
 {
 	return kawaii();
